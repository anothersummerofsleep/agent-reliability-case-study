# Copy to .env and fill in real values. .env is gitignored; never commit real keys.

# --- Model (LangChain init_chat_model "provider:model") ---
# Default provider is Google AI Studio (single API key, no Vertex/ADC setup).
MODEL_ID=google_genai:gemini-3.8-flash
GOOGLE_API_KEY=your-google-ai-studio-key
# To swap providers, change MODEL_ID and set the matching key, and install that
# provider extra, e.g.:
#   MODEL_ID=openai:gpt-4o-mini        + OPENAI_API_KEY=...        (pip install langchain-openai)
#   MODEL_ID=anthropic:claude-3-5-haiku-latest + ANTHROPIC_API_KEY=... (pip install langchain-anthropic)

# --- LangSmith tracing (OPTIONAL) ---
# Tracing is off by default. The offline tests and the persisted evaluation artifacts do
# not need it, and the live quickstart runs without a LangSmith account. Set it to true and
# fill in LANGSMITH_API_KEY only if you want traces sent to LangSmith.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your-langsmith-key
LANGSMITH_PROJECT=agent-reliability-case-study
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Legacy aliases (older LangChain): LANGCHAIN_TRACING_V2 / LANGCHAIN_API_KEY / LANGCHAIN_PROJECT
